{
  "name": "sunnify-webclient",
  "version": "0.1.0",
  "private": true,
  "description": "Web client for Sunnify - fetch Spotify playlist and track metadata in the browser. Companion to the desktop downloader.",
  "keywords": [
    "spotify",
    "playlist",
    "music",
    "metadata",
    "nextjs",
    "react"
  ],
  "homepage": "https://sunnify-spotify-downloader.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunnypatell/sunnify-spotify-downloader.git",
    "directory": "web-app/sunnify-webclient"
  },
  "author": {
    "name": "Sunny Jayendra Patel",
    "url": "https://github.com/sunnypatell"
  },
  "license": "SEE LICENSE IN ../../LICENSE",
  "bugs": {
    "url": "https://github.com/sunnypatell/sunnify-spotify-downloader/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd ../.. && husky web-app/sunnify-webclient/.husky || true"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "picomatch@2": "2.3.2",
    "postcss": "^8.5.33",
    "js-yaml@4": "^4.3.2",
    "postcss-selector-parser": "^7.1.6"
  }
}
